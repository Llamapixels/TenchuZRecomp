+         vk == rex::ui::VirtualKey::kMenu;
+}
+
+// TENCHUZ: key + modifier combinations that some bind spells out (e.g.
+// "Shift+Up" for the D-pad), as (mods << 8) | key. A bare token ("Up") only
+// gives way to those while the same modifiers are held, instead of to any
+// held modifier, so a key still works while Shift is held for another bind.
+using ChordSet = std::vector<uint16_t>;
+
+bool TokenPressed(const bool (&key_down)[256], std::string_view token, uint8_t live_mods,
+                  const ChordSet& chords) {
   uint8_t want = TakeModifiers(token);
-  if (want != live_mods) {
-    return false;
-  }
   rex::ui::VirtualKey vk = rex::ui::ParseVirtualKey(token);
   if (vk == rex::ui::VirtualKey::kNone) {
     return false;
   }
   uint16_t idx = static_cast<uint16_t>(vk);
-  return idx < 256 && key_down[idx];
+  if (idx >= 256 || !key_down[idx]) {
+    return false;
+  }
+  // A bare modifier ("Shift") is a key of its own.
+  if (want == 0 && IsModifierKey(vk)) {
+    return true;
+  }
+  if (want != 0) {
+    return want == live_mods;
+  }
+  if (live_mods == 0) {
+    return true;
+  }
+  const uint16_t chord = static_cast<uint16_t>((live_mods << 8) | idx);
+  return std::find(chords.begin(), chords.end(), chord) == chords.end();
+}
+
+// Adds the modifier+key combinations spelled out in one bind value.
+void CollectChords(std::string_view value, ChordSet& chords) {
+  while (!value.empty()) {
+    size_t comma = value.find(',');
+    std::string_view token = TrimSpaces(value.substr(0, comma));
+    value = comma == std::string_view::npos ? std::string_view() : value.substr(comma + 1);
+    uint8_t mods = TakeModifiers(token);
+    rex::ui::VirtualKey vk = rex::ui::ParseVirtualKey(token);
+    if (mods != 0 && vk != rex::ui::VirtualKey::kNone && static_cast<uint16_t>(vk) < 256) {
+      chords.push_back(static_cast<uint16_t>((mods << 8) | static_cast<uint16_t>(vk)));
+    }
+  }
 }
 
