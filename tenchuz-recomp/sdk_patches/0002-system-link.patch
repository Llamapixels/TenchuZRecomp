+// Player id: the fixed top bits of the default id (which keep the bits
+// 0x00C0000000000000 clear, as titles require) and 48 bits hashed from the
+// computer name and the user data folder.
+uint64_t MakePlayerXuid() {
+  std::string seed = rex::cvar::Query<std::string>("user_data_root");
+#if REX_PLATFORM_WIN32
+  char computer[256] = {};
+  DWORD length = sizeof(computer);
+  if (GetComputerNameA(computer, &length)) {
+    seed += computer;
+  }
+#endif
+  uint64_t hash = 1469598103934665603ull;  // FNV-1a
+  for (unsigned char c : seed) {
+    hash = (hash ^ c) * 1099511628211ull;
+  }
+  return 0xB13E000000000000ull | (hash & 0x0000FFFFFFFFFFFFull);
+}
