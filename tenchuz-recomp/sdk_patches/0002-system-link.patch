+// TENCHUZ: network call trace for System Link work.
+REXCVAR_DEFINE_BOOL(net_trace, false, "Network",
+                    "Log the title's network calls (sockets, XNet, QoS)");
+// TENCHUZ: System Link over IP.
+REXCVAR_DEFINE_STRING(net_bind_ip, "", "Network",
+                      "This machine's IPv4 address for System Link (empty = automatic). Set it "
+                      "to a VPN address to play over a virtual LAN, or to different "
+                      "127.0.0.x addresses to run two copies on one PC");
+REXCVAR_DEFINE_STRING(net_join_ip, "", "Network",
+                      "Host IPv4 address(es) to send System Link searches to, separated by "
+                      "';' (join by IP). Empty = broadcast to the local network");
+REXCVAR_DEFINE_STRING(net_public_ip, "", "Network",
+                      "This machine's internet IPv4 address, given to players on other "
+                      "networks (the game sets it after opening the router's ports with "
+                      "UPnP; set it yourself after forwarding the ports by hand)");
+
 namespace rex {
 namespace kernel {
 namespace xam {
 using namespace rex::system;
 using namespace rex::system::xam;
 
+namespace {
+// Caps the trace so a polling loop cannot flood the log.
+std::atomic<int> net_trace_budget{5000};
+
+template <typename... Args>
+void NetTrace(fmt::format_string<Args...> format, Args&&... args) {
+  if (!REXCVAR_GET(net_trace) || net_trace_budget.fetch_sub(1) <= 0) {
+    return;
+  }
+  REXKRNL_INFO("net: {}", fmt::format(format, std::forward<Args>(args)...));
+}
+
+// Host-order IPv4 address as text.
+std::string NetIp(uint32_t a) {
+  return fmt::format("{}.{}.{}.{}", a >> 24, (a >> 16) & 0xFF, (a >> 8) & 0xFF, a & 0xFF);
+}
+
+// First bytes of a buffer as hex, for recognising packets.
+std::string NetHex(const void* data, uint32_t length) {
+  std::string s;
+  const uint8_t* p = static_cast<const uint8_t*>(data);
+  for (uint32_t i = 0; i < std::min(length, 32u); ++i) {
+    s += fmt::format("{:02X}", p[i]);
+  }
+  return length > 32 ? s + "..." : s;
+}
+
+// Parses "a.b.c.d" to a host-order address; 0 if it is not one.
+uint32_t ParseIp(std::string_view text) {
+  std::string s(text);
+  s.erase(0, s.find_first_not_of(" \t"));
+  s.erase(s.find_last_not_of(" \t") + 1);
+  in_addr a = {};
+  if (s.empty() || inet_pton(AF_INET, s.c_str(), &a) != 1) {
+    return 0;
+  }
+  return ntohl(a.s_addr);
+}
+
+// The address other machines reach this one at (host order): net_bind_ip,
+// or the address the default route goes out of.
+uint32_t LocalIp() {
+  if (uint32_t bind_ip = ParseIp(REXCVAR_GET(net_bind_ip))) {
+    return bind_ip;
+  }
+  static const uint32_t automatic = [] {
+    uint32_t ip = INADDR_LOOPBACK;
+    auto s = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s != static_cast<decltype(s)>(-1)) {
+      sockaddr_in remote = {};
+      remote.sin_family = AF_INET;
+      remote.sin_port = htons(53);
+      remote.sin_addr.s_addr = htonl(0x08080808);  // no packet is sent
+      sockaddr_in local = {};
+      socklen_t length = sizeof(local);
+      if (::connect(s, reinterpret_cast<sockaddr*>(&remote), sizeof(remote)) == 0 &&
+          ::getsockname(s, reinterpret_cast<sockaddr*>(&local), &length) == 0 &&
+          local.sin_addr.s_addr != 0) {
+        ip = ntohl(local.sin_addr.s_addr);
+      }
+      rex::net::socket_close(static_cast<rex::net::SocketHandle>(s));
+    }
+    return ip;
+  }();
+  return automatic;
+}
+
+// TENCHUZ: the address players on other networks reach this one at (host
+// order), or 0 if not known.
+uint32_t PublicIp() { return ParseIp(REXCVAR_GET(net_public_ip)); }
+
+// TENCHUZ: true for addresses that only mean something inside one network
+// (private ranges and carrier-grade NAT).
+bool IsPrivateIp(uint32_t ip) {
+  return (ip >> 24) == 10 || (ip >> 20) == 0xAC1 || (ip >> 16) == 0xC0A8 ||
+         (ip >> 22) == 0x191;
+}
+
+std::vector<uint32_t> JoinIps() {
+  std::vector<uint32_t> ips;
+  const std::string list = REXCVAR_GET(net_join_ip);
+  size_t start = 0;
+  while (start <= list.size()) {
+    size_t end = list.find(';', start);
+    if (end == std::string::npos) end = list.size();
+    if (uint32_t ip = ParseIp(std::string_view(list).substr(start, end - start))) {
+      ips.push_back(ip);
+    }
+    start = end + 1;
+  }
+  return ips;
+}
+
+// TENCHUZ: who sent to each socket lately (host-order IPs, by socket
+// handle). A broadcast (the host answering a System Link search) also goes
+// to these, so searchers that are not on this network (joining by code or
+// over a virtual LAN without broadcasts) get the answer.
+struct RecentPeer {
+  uint32_t ip;
+  std::chrono::steady_clock::time_point seen;
+};
+std::mutex recent_peers_mutex;
+std::map<uint32_t, std::vector<RecentPeer>> recent_peers;
+
+void NoteRecentPeer(uint32_t socket, uint32_t ip) {
+  const auto now = std::chrono::steady_clock::now();
+  std::lock_guard lock(recent_peers_mutex);
+  auto& list = recent_peers[socket];
+  std::erase_if(list, [&](const RecentPeer& p) {
+    return p.ip == ip || now - p.seen > std::chrono::seconds(30);
+  });
+  if (list.size() < 16) list.push_back({ip, now});
+}
+
+std::vector<uint32_t> RecentPeers(uint32_t socket) {
+  const auto now = std::chrono::steady_clock::now();
+  std::vector<uint32_t> ips;
+  std::lock_guard lock(recent_peers_mutex);
+  auto it = recent_peers.find(socket);
+  if (it != recent_peers.end()) {
+    for (const RecentPeer& p : it->second) {
+      if (now - p.seen <= std::chrono::seconds(10)) ips.push_back(p.ip);
+    }
+  }
+  return ips;
+}
+
+void RandomBytes(uint8_t* out, size_t count) {
+  static std::mutex mutex;
+  static std::mt19937_64 engine{std::random_device{}()};
+  std::lock_guard lock(mutex);
+  for (size_t i = 0; i < count; ++i) {
+    out[i] = static_cast<uint8_t>(engine());
+  }
+}
