+/**
+ * @file        shader_override.h
+ * @brief       Replacing translated guest pixel shaders with HLSL files.
+ *
+ * @remarks     Added for the Tenchu Z port (TENCHUZ). A guest shader is
+ *              identified by its ucode hash. If one of the override
+ *              directories contains <hash>.ps.hlsl, it is compiled with the
+ *              system D3DCompiler (d3dcompiler_47.dll) as ps_5_1 and replaces
+ *              the translated DXBC.
+ *
+ *              The override includes "xe_interface.hlsli", which is generated
+ *              per shader from the translator's own metadata so the replacement
+ *              matches the original exactly: the input signature (interpolators
+ *              in TEXCOORD order, SV_Position, SV_IsFrontFace), the packed
+ *              float constants (C<n> for every guest c<n> the original reads),
+ *              bool / loop / fetch constants, texture and sampler registers by
+ *              fetch constant, and XeOutputColor(), which applies alpha test,
+ *              the render target exponent bias and gamma conversion the way
+ *              the translator does.
+ *
+ *              Both resource binding modes are supported: with bindless
+ *              binding (the default) textures and samplers are taken from
+ *              the descriptor heaps by the per-draw descriptor indices, with
+ *              bindful binding (d3d12_bindless = false) by register.
+ */
+
+#pragma once
+
+#include <filesystem>
+#include <string>
+
+#include <rex/graphics/d3d12/shader.h>
+
+namespace rex::graphics::d3d12 {
+
+struct ShaderOverrideContext {
+  bool bindless_resources_used;
+  bool gamma_render_target_as_unorm8;
+};
+
+// Generates the HLSL interface header for a translated pixel shader.
+std::string BuildShaderOverrideInterface(const D3D12Shader::D3D12Translation& translation,
+                                         const ShaderOverrideContext& context);
+
+// Looks for an override of the translated shader in the directories listed
+// in the shader_override_dir cvar and, if one compiles, replaces the
+// translation's binary with it. Returns true if replaced.
+bool ApplyShaderOverride(D3D12Shader::D3D12Translation& translation,
+                         const ShaderOverrideContext& context);
+
+// Values the game passes to every override (XeUser(0) .. XeUser(63) in HLSL),
+// for live settings. Set from any thread; read when system constants update.
+constexpr uint32_t kShaderOverrideUserValueCount = 64;
+void SetShaderOverrideUserValues(const float* values, uint32_t count);
+float GetShaderOverrideUserValue(uint32_t index);
+
+// Writes shader_<hash>.ps.stub.hlsl (a starting point for an override) and
+// shader_<hash>.ps.interface.hlsli next to the other dumped shader files.
+void DumpShaderOverrideStub(const std::filesystem::path& dump_dir,
+                            const D3D12Shader::D3D12Translation& translation,
+                            const ShaderOverrideContext& context);
+
+}  // namespace rex::graphics::d3d12
