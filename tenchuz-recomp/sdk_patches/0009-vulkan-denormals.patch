+spv::Id SpirvShaderTranslator::IsSm3MultiplicandZero(spv::Id min_abs, uint32_t num_components) {
+  // TENCHUZ: the guest treats denormals as zero here. Hosts that flush them
+  // compare them equal to 0, but some (NVIDIA on Vulkan) keep them, so a
+  // denormal times a huge value would not come out as zero.
+  if (features_.denorm_flush_to_zero_float32) {
+    return builder_->createBinOp(spv::OpFOrdEqual, type_bool_vectors_[num_components - 1],
+                                 min_abs, const_float_vectors_0_[num_components - 1]);
+  }
+  spv::Id float_min = builder_->makeFloatConstant(FLT_MIN);
+  if (num_components > 1) {
+    std::vector<spv::Id> float_min_components(num_components, float_min);
+    float_min = builder_->makeCompositeConstant(type_float_vectors_[num_components - 1],
+                                                float_min_components);
+  }
+  return builder_->createBinOp(spv::OpFOrdLessThan, type_bool_vectors_[num_components - 1],
+                               min_abs, float_min);
+}
