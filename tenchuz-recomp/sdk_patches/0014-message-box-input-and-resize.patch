+void WindowSDL::RepositionAfterResizeIfDue() {
+  if (!reposition_due_ms_ || !sdl_window_ || SDL_GetTicks() < reposition_due_ms_) {
+    return;
+  }
+#if REX_PLATFORM_WIN32
+  // Still dragging the edge: wait until the button is released.
+  if (GetAsyncKeyState(GetSystemMetrics(SM_SWAPBUTTON) ? VK_RBUTTON : VK_LBUTTON) & 0x8000) {
+    reposition_due_ms_ = SDL_GetTicks() + 100;
+    return;
+  }
+  reposition_due_ms_ = 0;
+  SDL_WindowFlags flags = SDL_GetWindowFlags(sdl_window_);
+  if (flags & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_MINIMIZED | SDL_WINDOW_MAXIMIZED)) {
+    return;
+  }
+  HWND hwnd = static_cast<HWND>(SDL_GetPointerProperty(
+      SDL_GetWindowProperties(sdl_window_), SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr));
+  RECT rect;
+  if (!hwnd || !GetWindowRect(hwnd, &rect)) {
+    return;
+  }
+  const UINT keep = SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER;
+  SetWindowPos(hwnd, nullptr, rect.left + 1, rect.top, 0, 0, keep);
+  SetWindowPos(hwnd, nullptr, rect.left, rect.top, 0, 0, keep | SWP_FRAMECHANGED);
+  REXLOG_DEBUG("Window nudged after a resize to refresh its picture position");
+#else
+  reposition_due_ms_ = 0;
+#endif
+}
