+
+void CommandProcessor::TransformOverlayNdc(float* scale, float* offset,
+    const uint32_t* viewport_offset, const uint32_t* viewport_extent,
+    uint32_t draw_scale_x, uint32_t draw_scale_y, bool bottom_left) const {
+  if (!overlay_phase_ || !g_overlay_after_shader.load(std::memory_order_relaxed)) return;
+  const float sx = g_overlay_scale_x.load(std::memory_order_relaxed);
+  const float sy = g_overlay_scale_y.load(std::memory_order_relaxed);
+  const float sizes[] = {g_overlay_frame_width.load(std::memory_order_relaxed) * draw_scale_x,
+                          g_overlay_frame_height.load(std::memory_order_relaxed) * draw_scale_y};
+  const float factors[] = {sx, sy};
+  const float shifts[] = {g_overlay_offset_x.load(std::memory_order_relaxed),
+                           g_overlay_offset_y.load(std::memory_order_relaxed)};
+  for (uint32_t axis = 0; axis < 2; ++axis) {
+    if (!viewport_extent[axis]) continue;
+    const float factor = factors[axis];
+    const float sign = axis == 1 && bottom_left ? -1.0f : 1.0f;
+    // Unnormalized UI can use a huge synthetic host viewport. Transform about
+    // the visible frame's center, not the synthetic viewport's center.
+    const float correction = (1.0f - factor) *
+        ((sizes[axis] - 2.0f * viewport_offset[axis]) / viewport_extent[axis] - 1.0f) +
+        2.0f * shifts[axis] * sizes[axis] / viewport_extent[axis];
+    scale[axis] *= factor;
+    offset[axis] = offset[axis] * factor + sign * correction;
+  }
+}
+
+void CommandProcessor::TransformOverlayScissor(uint32_t* offset, uint32_t* extent,
+    uint32_t draw_scale_x, uint32_t draw_scale_y) const {
+  if (!overlay_phase_ || !g_overlay_after_shader.load(std::memory_order_relaxed)) return;
+  const float scales[] = {g_overlay_scale_x.load(std::memory_order_relaxed),
+                           g_overlay_scale_y.load(std::memory_order_relaxed)};
+  const float shifts[] = {g_overlay_offset_x.load(std::memory_order_relaxed),
+                           g_overlay_offset_y.load(std::memory_order_relaxed)};
+  const double sizes[] = {double(g_overlay_frame_width.load(std::memory_order_relaxed)) * draw_scale_x,
+                           double(g_overlay_frame_height.load(std::memory_order_relaxed)) * draw_scale_y};
+  for (uint32_t axis = 0; axis < 2; ++axis) {
+    const double center = 0.5 * sizes[axis];
+    const double shift = double(shifts[axis]) * sizes[axis];
+    const double lo = center + (double(offset[axis]) - center) * scales[axis] + shift;
+    const double hi = lo + double(extent[axis]) * scales[axis];
+    const double bound = sizes[axis];
+    const auto clipped_lo = uint32_t(std::clamp(std::floor(lo), 0.0, bound));
+    const auto clipped_hi = uint32_t(std::clamp(std::ceil(hi), double(clipped_lo), bound));
+    offset[axis] = clipped_lo;
+    extent[axis] = clipped_hi - clipped_lo;
+  }
+}
 
