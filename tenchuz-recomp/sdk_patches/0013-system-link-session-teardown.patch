+
+// TENCHUZ: the title's TCP connections (connected or accepted), by socket
+// handle. On a console, unregistering a session key drops the secure links
+// made with it, so a peer's recv() sees the connection end. Plain sockets
+// stay up, and after a System Link mission the host and the players each
+// wait for the other's connection to drop. XNetUnregisterKey shuts these
+// down to match.
+std::mutex tcp_sockets_mutex;
+std::vector<uint32_t> tcp_sockets;
+
+bool IsStreamSocket(XSocket* socket) {
+  int type = 0;
+#if REX_PLATFORM_WIN32
+  int len = sizeof(type);
+  if (getsockopt(static_cast<SOCKET>(socket->native_handle()), SOL_SOCKET, SO_TYPE,
+                 reinterpret_cast<char*>(&type), &len) != 0) {
+    return false;
+  }
+#else
+  socklen_t len = sizeof(type);
+  if (getsockopt(static_cast<int>(socket->native_handle()), SOL_SOCKET, SO_TYPE, &type,
+                 &len) != 0) {
+    return false;
+  }
+#endif
+  return type == SOCK_STREAM;
+}
+
+void NoteTcpSocket(XSocket* socket) {
+  if (!IsStreamSocket(socket)) return;
+  std::lock_guard lock(tcp_sockets_mutex);
+  const uint32_t handle = socket->handle();
+  if (std::find(tcp_sockets.begin(), tcp_sockets.end(), handle) == tcp_sockets.end()) {
+    tcp_sockets.push_back(handle);
+  }
+}
+
+void ForgetTcpSocket(uint32_t handle) {
+  std::lock_guard lock(tcp_sockets_mutex);
+  std::erase(tcp_sockets, handle);
+}
+
+int LastSocketError() {
+#if REX_PLATFORM_WIN32
+  return WSAGetLastError();
+#else
+  return errno;
+#endif
+}
 }  // namespace
 
 
