 u32 NetDll_XNetUnregisterKey_entry(u32 caller, mapped_void key_id) {
   NetTrace("XNetUnregisterKey(id {})", key_id ? NetHex(key_id, 8) : std::string("-"));
+  if (REXCVAR_GET(net_unregister_drops_tcp)) {
+    std::vector<uint32_t> handles;
+    {
+      std::lock_guard lock(tcp_sockets_mutex);
+      handles.swap(tcp_sockets);
+    }
+    for (uint32_t handle : handles) {
+      auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(handle);
+      if (!socket) continue;
+      // 2 = both directions: the peer's recv() returns 0, ours fails.
+      const int ret = socket->Shutdown(2);
+      NetTrace("XNetUnregisterKey: shut down TCP {:08X} = {}", handle, ret);
+    }
+  }
   return 0;
